# ══════════════════════════════════════════════════════════════════
#  OpenSCAD Mechanical Copilot — environment configuration
#  Copy this file to  .env  and fill in the values you need.
#  The app starts without any keys set (Ollama-only mode).
# ══════════════════════════════════════════════════════════════════

# ── LLM providers (set at least one) ─────────────────────────────
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o

# OpenRouter  (free tier available — gemma-4-31b-it:free is the default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-120b:free
OPENROUTER_ALLOW_PAID=false
OPENROUTER_TIMEOUT_SEC=120

# HuggingFace Router
HF_TOKEN=
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest

# Ollama (local — default base URL)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODELS=qwen2.5-coder:7b,mistral:7b-instruct,codellama:latest
OLLAMA_MAX_TOKENS=2400
OLLAMA_NUM_CTX=4096
OLLAMA_GENERATE_TIMEOUT_SEC=900

# ── RAG / Embeddings ──────────────────────────────────────────────
# Options: "auto" (sentence-transformers if installed, else tfidf)
#          "tfidf" (fast, no GPU, slightly lower recall)
#          "ollama" (use nomic-embed-text via Ollama)
EMBEDDING_BACKEND=auto

# Sentence-Transformers model (used when EMBEDDING_BACKEND=auto or sentence-transformers)
SENTENCE_MODEL_NAME=all-MiniLM-L6-v2

# Ollama embedding model (used when EMBEDDING_BACKEND=ollama)
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
NOMIC_USE_PREFIX=false

# ── Generation behaviour ──────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=2
ENABLE_CLARIFICATION=false

# ── OpenSCAD CLI (for STL export and 3D preview) ──────────────────
OPENSCAD_BIN=openscad
OPENSCAD_EXPORT_TIMEOUT_SEC=120
