{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "EMBEDDING_BACKEND": "tfidf",
    "ACTIVE_PART_FAMILY_ID": "general_mechanical_parts",
    "ACTIVE_PART_FAMILY_LABEL": "General Mechanical Parts"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
